# --- Frontend (Vite) ---
# Public Supabase config — safe to expose; RLS protects the data.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Edge Functions (set via `supabase secrets set` or the Studio UI) ---
# These are NEVER exposed to the browser.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
AI_PROVIDER=openai            # one of: openai | anthropic
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini      # optional, defaults to gpt-4o-mini
ANTHROPIC_API_KEY=             # only required when AI_PROVIDER=anthropic
YOUTUBE_API_KEY=AIza...
